class VersionGeneratorPlugin : Plugin<Project> {
    override fun apply(project: Project) {
        project.afterEvaluate {
            val appVersion = libs.versions.appVersion.get()
            val versionFile = project.layout.buildDirectory
                .file("generated/src/commonMain/kotlin/com/qtkai/zhong/Version.kt")
                .get().asFile
            versionFile.parentFile?.mkdirs()
            versionFile.writeText("""
                package com.qtkai.zhong
                
                object Version {
                    const val appVersion = "$appVersion"
                }
            """.trimIndent())
        }
    }
}

apply<VersionGeneratorPlugin>()